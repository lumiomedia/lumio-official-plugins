{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/lib/plugin-sdk": ["./src/__test-stubs__/plugin-sdk.ts"]
    }
  },
  "include": ["runtime/**/*", "src/**/*", "vitest.config.ts"]
}
